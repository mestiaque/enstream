{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The start-up screen (bundled page): status of the server, retry, open the log folder, window controls.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-server-status",
    "allow-restart-server",
    "allow-open-app-folder",
    "allow-quit-app"
  ]
}
